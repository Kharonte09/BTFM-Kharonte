---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import EntryCard from '@/components/EntryCard.astro';
import { cheatsheetPath, getCheatsheets, refCode } from '@/lib/content';

const sheets = await getCheatsheets();
const summary = 'Filterable quick-reference tables for use during an investigation.';
---

<BaseLayout title="Cheatsheets" description={summary}>
  <PageHeader title="Cheatsheets" summary={summary} crumbs={[{ label: 'Cheatsheets' }]} />
  <ul class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      sheets.map((s) => (
        <li>
          <EntryCard
            href={cheatsheetPath(s)}
            title={s.data.name}
            summary={s.data.summary}
            code={refCode('cheatsheet', s.id)}
            meta={`${s.data.sections.reduce((n, sec) => n + sec.rows.length, 0)} rows`}
          />
        </li>
      ))
    }
  </ul>
</BaseLayout>
