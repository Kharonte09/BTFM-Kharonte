---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CategoryBlock from '@/components/CategoryBlock.astro';
import { artifactPath, getArtifacts, refCode } from '@/lib/content';
import { ARTIFACT_CATEGORIES } from '@/lib/taxonomy';

export const getStaticPaths = (() =>
  ARTIFACT_CATEGORIES.map((category) => ({
    params: { category: category.id },
    props: { category },
  }))) satisfies GetStaticPaths;

const { category } = Astro.props;
const artifacts = (await getArtifacts()).filter((a) => a.data.category === category.id);
---

<BaseLayout title={`${category.label} artifacts`} description={category.description}>
  <PageHeader
    title={`${category.label} artifacts`}
    summary={category.description}
    crumbs={[{ label: 'Artifacts', href: '/artifacts/' }, { label: category.label }]}
  />
  <div class="mt-10">
    <CategoryBlock
      category={category}
      entries={artifacts.map((a) => ({
        href: artifactPath(a),
        title: a.data.name,
        summary: a.data.summary,
        code: refCode('artifact', a.id, a.data.category),
      }))}
    />
  </div>
</BaseLayout>
