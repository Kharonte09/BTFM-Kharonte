---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchPanel from '@/components/SearchPanel.astro';
import { url } from '@/lib/url';
---

<BaseLayout title="Not found" noindex>
  <section class="max-w-2xl py-10">
    <p class="label text-ember">404 · No artifact at this path</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-paper">Nothing recovered here.</h1>
    <p class="mt-3 text-paper-dim">
      The page may have moved. Search the manual or go back to the <a href={url('/')} class="link">index</a>.
    </p>
    <div class="mt-8">
      <SearchPanel id="nf-search" primary />
    </div>
  </section>
</BaseLayout>
