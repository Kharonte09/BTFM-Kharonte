---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchPanel from '@/components/SearchPanel.astro';
import { url } from '@/lib/url';
import { useTranslations } from '@/i18n/ui';

// GitHub Pages serves this single file for every unknown path, so it is
// rendered in the default language with a pointer to the Spanish index.
const t = useTranslations('en');
const es = useTranslations('es');
---

<BaseLayout title={t('nf.title')} noindex>
  <section class="max-w-2xl py-10">
    <p class="label text-ember">{t('nf.kicker')}</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-paper">{t('nf.h1')}</h1>
    <p class="mt-3 text-paper-dim">
      {t('nf.body')} <a href={url('/')} class="link">{t('nf.index')}</a>.
    </p>
    <p class="mt-1 text-sm text-mute" lang="es">
      {es('nf.body')} <a href={url('/es/')} class="link">{es('nf.index')}</a>.
    </p>
    <div class="mt-8">
      <SearchPanel id="nf-search" primary />
    </div>
  </section>
</BaseLayout>
