---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SearchPanel from '@/components/SearchPanel.astro';
---

<BaseLayout
  title="Search"
  description="Search tools, artifacts, playbooks, event IDs and commands in the Kharonte field manual."
>
  <PageHeader
    title="Search"
    summary="Tools, artifacts, playbooks, event IDs, commands and techniques. Everything runs in your browser."
    crumbs={[{ label: 'Search' }]}
  />
  <div class="mt-8 max-w-3xl">
    <SearchPanel id="page-search" mode="page" size="lg" primary />
  </div>
  <noscript>
    <p class="mt-6 text-sm text-mute">Search requires JavaScript. Browse the sections from the main menu instead.</p>
  </noscript>
</BaseLayout>
