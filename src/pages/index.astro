---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchPanel from '@/components/SearchPanel.astro';
import Icon from '@/components/Icon.astro';
import Flow from '@/components/Flow.astro';
import {
  cheatsheetPath,
  getArtifacts,
  getCheatsheets,
  getPlaybooks,
  getTools,
  playbookPath,
} from '@/lib/content';
import { ARTIFACT_CATEGORIES, TOOL_CATEGORIES } from '@/lib/taxonomy';
import { url } from '@/lib/url';

const [artifacts, tools, playbooks, sheets] = await Promise.all([
  getArtifacts(),
  getTools(),
  getPlaybooks(),
  getCheatsheets(),
]);

const countBy = <T extends { data: { category: string } }>(items: T[], id: string) =>
  items.filter((i) => i.data.category === id).length;

const toolCategories = TOOL_CATEGORIES.filter((c) => countBy(tools, c.id) > 0);

const stats = [
  { label: 'Artifacts', value: artifacts.length, href: '/artifacts/' },
  { label: 'Tools', value: tools.length, href: '/tools/' },
  { label: 'Playbooks', value: playbooks.length, href: '/playbooks/' },
  { label: 'Cheatsheets', value: sheets.length, href: '/cheatsheets/' },
];
---

<BaseLayout>
  <!-- Masthead -->
  <section aria-labelledby="masthead" class="grid gap-10 pt-4 pb-14 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-16 lg:pt-10">
    <div class="min-w-0">
      <p class="label flex items-center gap-3">
        <span class="text-ember">KHARONTE</span>
        <span class="h-px w-8 bg-ink-600" aria-hidden="true"></span>
        <span>Ref. manual · v0.1</span>
      </p>
      <h1 id="masthead" class="mt-5 text-4xl leading-[1.05] font-semibold tracking-tight text-paper sm:text-6xl">
        Blue Team<br />Field Manual
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-paper-dim">
        A practical reference for DFIR, detection and malware analysis.{' '}
        <span class="text-mute">You have an artifact in front of you — what do you do next?</span>
      </p>

      <div class="mt-9 max-w-3xl">
        <SearchPanel id="home-search" size="lg" primary />
      </div>
    </div>

    <ul class="grid grid-cols-2 gap-px self-start border border-ink-700 bg-ink-700 lg:grid-cols-1" aria-label="Contents">
      {
        stats.map((s) => (
          <li class="bg-ink-950">
            <a href={url(s.href)} class="group flex items-baseline justify-between px-4 py-3 transition-colors hover:bg-ink-900">
              <span class="label group-hover:text-paper-dim">{s.label}</span>
              <span class="font-mono text-2xl text-paper tabular-nums">{String(s.value).padStart(2, '0')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Start with an artifact -->
  <section aria-labelledby="start-artifact" class="border-t border-ink-700 py-12">
    <div class="mb-6 flex items-baseline justify-between gap-4">
      <h2 id="start-artifact" class="label"><span class="mr-3 text-ember">01</span>Start with an artifact</h2>
      <a href={url('/artifacts/')} class="font-mono text-xs text-mute hover:text-paper">All artifacts →</a>
    </div>
    <ul class="grid grid-cols-2 gap-px border border-ink-700 bg-ink-700 sm:grid-cols-3 lg:grid-cols-6">
      {
        ARTIFACT_CATEGORIES.map((c) => (
          <li class="bg-ink-950">
            <a
              href={url(`/artifacts/${c.id}/`)}
              class="group flex h-full flex-col gap-6 p-4 transition-colors hover:bg-ink-900 sm:p-5"
            >
              <span class="flex items-center justify-between">
                <Icon name={c.icon} size={20} class="text-mute transition-colors group-hover:text-ember" />
                <span class="font-mono text-[0.6875rem] text-faint">{String(countBy(artifacts, c.id)).padStart(2, '0')}</span>
              </span>
              <span>
                <span class="block font-medium text-paper">{c.label}</span>
                <span class="mt-1 hidden text-xs leading-snug text-mute sm:block">{c.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Playbooks -->
  <section aria-labelledby="pop-playbooks" class="border-t border-ink-700 py-12">
    <div class="mb-6 flex items-baseline justify-between gap-4">
      <h2 id="pop-playbooks" class="label"><span class="mr-3 text-ember">02</span>Playbooks</h2>
      <a href={url('/playbooks/')} class="font-mono text-xs text-mute hover:text-paper">All playbooks →</a>
    </div>
    <ul class="divide-y divide-ink-700 border-y border-ink-700">
      {
        playbooks.map((p, i) => (
          <li>
            <a
              href={url(playbookPath(p))}
              class="group grid gap-3 py-4 transition-colors hover:bg-ink-900 md:grid-cols-[2.5rem_16rem_minmax(0,1fr)] md:items-center md:gap-6 md:px-2"
            >
              <span class="hidden font-mono text-xs text-faint md:block">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex items-center gap-2 font-medium text-paper">
                {p.data.name}
                <span aria-hidden="true" class="text-ember opacity-0 transition-opacity group-hover:opacity-100">→</span>
              </span>
              <span class="min-w-0 overflow-hidden" aria-hidden="true">
                <Flow steps={p.data.steps.map((s) => s.title).slice(0, 6)} compact />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Tools + cheatsheets -->
  <section class="grid gap-12 border-t border-ink-700 py-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <div aria-labelledby="tools-h" class="min-w-0">
      <div class="mb-6 flex items-baseline justify-between gap-4">
        <h2 id="tools-h" class="label"><span class="mr-3 text-ember">03</span>Tools</h2>
        <a href={url('/tools/')} class="font-mono text-xs text-mute hover:text-paper">All tools →</a>
      </div>
      <ul class="grid gap-px border border-ink-700 bg-ink-700 sm:grid-cols-2">
        {
          toolCategories.map((c) => (
            <li class="bg-ink-950">
              <a href={url(`/tools/${c.id}/`)} class="group flex h-full items-start gap-4 p-4 transition-colors hover:bg-ink-900">
                <Icon name={c.icon} size={18} class="mt-0.5 shrink-0 text-mute group-hover:text-ember" />
                <span class="min-w-0">
                  <span class="flex items-baseline gap-2">
                    <span class="font-medium text-paper">{c.label}</span>
                    <span class="font-mono text-[0.6875rem] text-faint">{String(countBy(tools, c.id)).padStart(2, '0')}</span>
                  </span>
                  <span class="mt-1 block truncate text-xs text-mute">
                    {tools.filter((t) => t.data.category === c.id).map((t) => t.data.name).join(' · ')}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div aria-labelledby="sheets-h" class="min-w-0">
      <div class="mb-6 flex items-baseline justify-between gap-4">
        <h2 id="sheets-h" class="label"><span class="mr-3 text-ember">04</span>Cheatsheets</h2>
      </div>
      <ul class="divide-y divide-ink-700 border-y border-ink-700">
        {
          sheets.map((s) => (
            <li>
              <a href={url(cheatsheetPath(s))} class="group block py-3.5 transition-colors hover:bg-ink-900 sm:px-2">
                <span class="flex items-center gap-2 font-medium text-paper">
                  {s.data.name}
                  <span aria-hidden="true" class="text-ember opacity-0 transition-opacity group-hover:opacity-100">→</span>
                </span>
                <span class="mt-0.5 block text-sm text-mute">{s.data.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <aside class="border border-ink-700 bg-ink-900 px-5 py-4 text-sm leading-relaxed text-mute">
    <span class="label mr-2 text-ember">Scope</span>
    Kharonte is a reference to support your analysis, not an automated analyst. It never executes
    samples and does not call external services. Verify findings against primary sources.
  </aside>
</BaseLayout>
