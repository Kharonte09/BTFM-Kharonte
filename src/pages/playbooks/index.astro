---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Flow from '@/components/Flow.astro';
import { getPlaybooks, playbookPath, refCode } from '@/lib/content';
import { url } from '@/lib/url';

const playbooks = await getPlaybooks();
const summary =
  'High-level investigation workflows. Each step states its goal, the tools and artifacts involved, and when to escalate.';
---

<BaseLayout title="Playbooks" description={summary}>
  <PageHeader title="Playbooks" summary={summary} crumbs={[{ label: 'Playbooks' }]} />

  <ol class="mt-10 space-y-4">
    {
      playbooks.map((p, i) => (
        <li>
          <a
            href={url(playbookPath(p))}
            class="group block border border-ink-700 bg-ink-900 p-5 transition-colors hover:border-ink-500 hover:bg-ink-850"
          >
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <span class="font-mono text-xs text-ember">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="text-lg font-semibold text-paper">{p.data.name}</h2>
              <span class="label text-faint">{refCode('playbook', p.id)}</span>
              <span class="label ml-auto text-faint">{p.data.steps.length} steps</span>
            </div>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-mute">{p.data.summary}</p>
            <div class="mt-4" aria-hidden="true">
              <Flow steps={p.data.steps.map((s) => s.title)} compact />
            </div>
          </a>
        </li>
      ))
    }
  </ol>
</BaseLayout>
