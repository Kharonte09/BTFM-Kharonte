---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchPanel from '@/components/SearchPanel.astro';
import PlaybookCard from '@/components/PlaybookCard.astro';
import Icon from '@/components/Icon.astro';
import { getArtifacts, getPlaybooks, getTools } from '@/lib/content';
import { ARTIFACT_CATEGORIES, TOOL_CATEGORIES } from '@/lib/taxonomy';
import { href } from '@/lib/url';
import { localeStaticPaths } from '@/i18n/routing';
import { useTranslations, type Lang } from '@/i18n/ui';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const [artifacts, tools, playbooks] = await Promise.all([
  getArtifacts(lang),
  getTools(lang),
  getPlaybooks(lang),
]);

const countBy = <T extends { data: { category: string } }>(items: T[], id: string) =>
  items.filter((i) => i.data.category === id).length;

const toolCategories = TOOL_CATEGORIES.filter((c) => countBy(tools, c.id) > 0);

const stats = [
  { label: t('nav.playbooks'), value: playbooks.length, href: '/playbooks/' },
  { label: t('nav.artifacts'), value: artifacts.length, href: '/artifacts/' },
  { label: t('nav.tools'), value: tools.length, href: '/tools/' },
];

const refRow =
  'group flex items-center gap-3 py-2.5 text-sm text-paper-dim transition-colors hover:text-paper sm:px-2 hover:bg-ink-900';
---

<BaseLayout>
  <!-- Masthead -->
  <section
    aria-labelledby="masthead"
    class="grid gap-10 pt-4 pb-14 lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-16 lg:pt-10"
  >
    <div class="min-w-0">
      <p class="label flex items-center gap-3">
        <span class="text-ember">KHARONTE</span>
        <span class="h-px w-8 bg-ink-600" aria-hidden="true"></span>
        <span>{t('home.kicker')}</span>
      </p>
      <h1 id="masthead" class="mt-5 text-4xl leading-[1.05] font-semibold tracking-tight text-paper sm:text-6xl">
        {t('home.h1a')}<br />{t('home.h1b')}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-paper-dim">
        {t('home.lead')}{' '}
        <span class="text-mute">{t('home.lead2')}</span>
      </p>

      <div class="mt-9 max-w-3xl">
        <SearchPanel id="home-search" size="lg" primary />
      </div>
    </div>

    <ul
      class="grid grid-cols-2 gap-px self-start border border-ink-700 bg-ink-700 lg:grid-cols-1"
      aria-label={t('home.contents')}
    >
      {
        stats.map((s, i) => (
          <li class="bg-ink-950">
            <a
              href={href(lang, s.href)}
              class="group flex items-baseline justify-between gap-2 px-4 py-3 transition-colors hover:bg-ink-900"
            >
              <span class:list={['label truncate group-hover:text-paper-dim', i === 0 && 'text-ember']}>{s.label}</span>
              <span class="font-mono text-2xl text-paper tabular-nums">{String(s.value).padStart(2, '0')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Playbooks: the entry point -->
  <section aria-labelledby="pick" class="border-t border-ink-700 py-12">
    <div class="mb-6 flex items-baseline justify-between gap-4">
      <h2 id="pick" class="label"><span class="mr-3 text-ember">01</span>{t('home.pick')}</h2>
      <a href={href(lang, '/playbooks/')} class="font-mono text-xs text-mute hover:text-paper">
        {t('home.allPlaybooks')}
      </a>
    </div>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        playbooks.map((p, i) => (
          <li>
            <PlaybookCard playbook={p} index={i + 1} />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Reference: supports the playbooks -->
  <section aria-labelledby="reference" class="border-t border-ink-700 py-12">
    <div class="mb-8 max-w-2xl">
      <h2 id="reference" class="label"><span class="mr-3 text-ember">02</span>{t('home.reference')}</h2>
      <p class="mt-3 text-sm leading-relaxed text-mute">{t('home.referenceText')}</p>
    </div>

    <div class="grid gap-10 md:grid-cols-2">
      <div class="min-w-0">
        <div class="mb-3 flex items-baseline justify-between gap-3 border-b border-ink-700 pb-2">
          <h3 class="font-semibold text-paper">{t('nav.artifacts')}</h3>
          <a href={href(lang, '/artifacts/')} class="font-mono text-xs text-mute hover:text-paper">→</a>
        </div>
        <ul class="divide-y divide-ink-800">
          {
            ARTIFACT_CATEGORIES.map((c) => (
              <li>
                <a href={href(lang, `/artifacts/${c.id}/`)} class={refRow}>
                  <Icon name={c.icon} size={16} class="shrink-0 text-mute group-hover:text-ember" />
                  <span class="flex-1">{c.label[lang]}</span>
                  <span class="font-mono text-[0.6875rem] text-faint">
                    {String(countBy(artifacts, c.id)).padStart(2, '0')}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="min-w-0">
        <div class="mb-3 flex items-baseline justify-between gap-3 border-b border-ink-700 pb-2">
          <h3 class="font-semibold text-paper">{t('nav.tools')}</h3>
          <a href={href(lang, '/tools/')} class="font-mono text-xs text-mute hover:text-paper">→</a>
        </div>
        <ul class="divide-y divide-ink-800">
          {
            toolCategories.map((c) => (
              <li>
                <a href={href(lang, `/tools/${c.id}/`)} class={refRow}>
                  <Icon name={c.icon} size={16} class="shrink-0 text-mute group-hover:text-ember" />
                  <span class="flex-1">{c.label[lang]}</span>
                  <span class="font-mono text-[0.6875rem] text-faint">
                    {String(countBy(tools, c.id)).padStart(2, '0')}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

    </div>
  </section>

  <aside class="border border-ink-700 bg-ink-900 px-5 py-4 text-sm leading-relaxed text-mute">
    <span class="label mr-2 text-ember">{t('home.scope')}</span>
    {t('home.scopeText')}
  </aside>
</BaseLayout>
