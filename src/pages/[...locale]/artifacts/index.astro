---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CategoryBlock from '@/components/CategoryBlock.astro';
import Icon from '@/components/Icon.astro';
import { artifactPath, getArtifacts, refCode, slugOf } from '@/lib/content';
import { ARTIFACT_CATEGORIES } from '@/lib/taxonomy';
import { localeStaticPaths } from '@/i18n/routing';
import { useTranslations, type Lang } from '@/i18n/ui';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const artifacts = await getArtifacts(lang);
---

<BaseLayout title={t('artifacts.title')} description={t('artifacts.summary')}>
  <PageHeader title={t('artifacts.title')} summary={t('artifacts.summary')} crumbs={[{ label: t('artifacts.title') }]}>
    <nav aria-label={t('cat.nav.artifacts')} class="mt-6">
      <ul class="flex flex-wrap gap-2">
        {
          ARTIFACT_CATEGORIES.map((c) => (
            <li>
              <a href={`#${c.id}`} class="chip">
                <Icon name={c.icon} size={13} class="text-ember" />
                {c.label[lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </PageHeader>

  <div class="mt-10 space-y-14">
    {
      ARTIFACT_CATEGORIES.map((c) => (
        <CategoryBlock
          category={c}
          href={`/artifacts/${c.id}/`}
          entries={artifacts
            .filter((a) => a.data.category === c.id)
            .map((a) => ({
              href: artifactPath(a),
              title: a.data.name,
              summary: a.data.summary,
              code: refCode('artifact', slugOf(a), a.data.category),
            }))}
        />
      ))
    }
  </div>
</BaseLayout>
