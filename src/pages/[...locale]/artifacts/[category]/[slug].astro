---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import EntryLayout from '@/layouts/EntryLayout.astro';
import Section from '@/components/Section.astro';
import BulletList from '@/components/BulletList.astro';
import Flow from '@/components/Flow.astro';
import StartHere from '@/components/StartHere.astro';
import ToolTiers from '@/components/ToolTiers.astro';
import MistakeList from '@/components/MistakeList.astro';
import WhatNext from '@/components/WhatNext.astro';
import UsedInPlaybooks from '@/components/UsedInPlaybooks.astro';
import type { TocItem } from '@/components/Toc.astro';
import {
  detectionsReferencing,
  getArtifacts,
  isFallback,
  playbooksReferencing,
  refCode,
  slugOf,
  toolsForArtifact,
  type Artifact,
} from '@/lib/content';
import { getArtifactCategory } from '@/lib/taxonomy';
import { perLocale } from '@/i18n/routing';
import { useTranslations, type Lang } from '@/i18n/ui';

export const getStaticPaths = (() =>
  perLocale(async (lang) =>
    (await getArtifacts(lang)).map((artifact) => ({
      params: { category: artifact.data.category, slug: slugOf(artifact) },
      props: { artifact },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  artifact: Artifact;
  lang: Lang;
}

const { artifact, lang } = Astro.props;
const t = useTranslations(lang);
const d = artifact.data;
const category = getArtifactCategory(d.category);
const { Content } = await render(artifact);
const hasBody = Boolean(artifact.body?.trim());

const allTools = [...d.tools_start, ...d.tools_deeper];
// Tools whose own page points back to this artifact, not already listed here.
const reverseTools = (await toolsForArtifact(artifact, lang)).map((x) => slugOf(x));
const playbooks = await playbooksReferencing(artifact, lang);
const detections = (await detectionsReferencing(artifact, lang)).map((x) => slugOf(x));
const nextTools = [...new Set([...allTools, ...reverseTools])];

const sections: (TocItem & { show: boolean })[] = [
  { id: 'start-here', label: t('sec.startHere'), show: d.start_here.length > 0 || d.start_commands.length > 0 },
  { id: 'why', label: t('sec.why'), show: d.why.length > 0 },
  { id: 'questions', label: t('sec.firstQuestions'), show: d.questions.length > 0 },
  { id: 'look-for', label: t('sec.lookFor'), show: d.look_for.length > 0 },
  { id: 'location', label: t('sec.location'), show: d.locations.length > 0 },
  { id: 'tools', label: t('sec.tools'), show: allTools.length > 0 },
  { id: 'reference', label: t('sec.reference'), show: hasBody },
  { id: 'correlate', label: t('sec.correlate'), show: d.correlate.length > 0 },
  { id: 'extract', label: t('sec.extract'), show: d.extract.length > 0 },
  { id: 'mistakes', label: t('sec.mistakes'), show: d.mistakes.length > 0 },
  { id: 'next', label: t('sec.next'), show: playbooks.length > 0 || detections.length > 0 || d.related_artifacts.length > 0 || nextTools.length > 0 },
];
const toc = sections.filter((s) => s.show);
const n = (id: string) => toc.findIndex((s) => s.id === id) + 1;
const label = (id: string) => toc.find((s) => s.id === id)?.label ?? id;
---

<EntryLayout
  title={d.name}
  summary={d.summary}
  code={refCode('artifact', slugOf(artifact), d.category)}
  crumbs={[
    { label: t('nav.artifacts'), href: '/artifacts/' },
    { label: category.label[lang], href: `/artifacts/${category.id}/` },
    { label: d.name },
  ]}
  meta={[
    { label: t('meta.category'), value: category.label[lang] },
    { label: t('meta.coverage'), value: t(`coverage.${d.coverage}`) },
  ]}
  toc={toc}
  review={d.review}
  fallback={isFallback(artifact, lang)}
  updated={d.updated}
>
  <UsedInPlaybooks slot="header" playbooks={playbooks} />

  {
    (d.start_here.length > 0 || d.start_commands.length > 0) && (
      <StartHere
        title={t('sec.startHere')}
        subtitle={t('sec.firstMinutes')}
        steps={d.start_here}
        commands={d.start_commands}
      />
    )
  }

  {
    d.why.length > 0 && (
      <Section id="why" title={label('why')} index={n('why')}>
        <BulletList items={d.why} />
      </Section>
    )
  }

  {
    d.questions.length > 0 && (
      <Section id="questions" title={label('questions')} index={n('questions')}>
        <BulletList items={d.questions} />
      </Section>
    )
  }

  {
    d.look_for.length > 0 && (
      <Section id="look-for" title={label('look-for')} index={n('look-for')}>
        <BulletList items={d.look_for} />
      </Section>
    )
  }

  {
    d.locations.length > 0 && (
      <Section id="location" title={label('location')} index={n('location')}>
        <ul class="divide-y divide-ink-800 border border-ink-700 bg-ink-900">
          {d.locations.map((l) => (
            <li class="flex flex-col gap-1 px-3 py-2.5 sm:flex-row sm:items-baseline sm:gap-4">
              {l.label && <span class="label w-40 shrink-0 tracking-normal normal-case">{l.label}</span>}
              <code class="font-mono text-[0.8125rem] break-all text-paper">{l.path}</code>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    allTools.length > 0 && (
      <Section id="tools" title={label('tools')} index={n('tools')}>
        <ToolTiers start={d.tools_start} deeper={d.tools_deeper} questions={d.tool_questions} />
      </Section>
    )
  }

  {
    hasBody && (
      <Section id="reference" title={label('reference')} index={n('reference')}>
        <div class="prose-k">
          <Content />
        </div>
      </Section>
    )
  }

  {
    d.correlate.length > 0 && (
      <Section id="correlate" title={label('correlate')} index={n('correlate')}>
        <Flow steps={d.correlate} />
      </Section>
    )
  }

  {
    d.extract.length > 0 && (
      <Section id="extract" title={label('extract')} index={n('extract')}>
        <BulletList items={d.extract} />
      </Section>
    )
  }

  {
    d.mistakes.length > 0 && (
      <Section id="mistakes" title={label('mistakes')} index={n('mistakes')}>
        <MistakeList items={d.mistakes} />
      </Section>
    )
  }

  {
    (playbooks.length > 0 || detections.length > 0 || d.related_artifacts.length > 0 || nextTools.length > 0) && (
      <Section id="next" title={label('next')} index={n('next')}>
        <WhatNext playbooks={playbooks} detections={detections} artifacts={d.related_artifacts} tools={nextTools} />
      </Section>
    )
  }
</EntryLayout>
