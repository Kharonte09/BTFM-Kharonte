---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import EntryLayout from '@/layouts/EntryLayout.astro';
import Section from '@/components/Section.astro';
import BulletList from '@/components/BulletList.astro';
import RefList from '@/components/RefList.astro';
import UsedInPlaybooks from '@/components/UsedInPlaybooks.astro';
import type { TocItem } from '@/components/Toc.astro';
import {
  getArtifacts,
  isFallback,
  playbooksReferencing,
  refCode,
  slugOf,
  toolsForArtifact,
  type Artifact,
} from '@/lib/content';
import { getArtifactCategory } from '@/lib/taxonomy';
import { perLocale } from '@/i18n/routing';
import { useTranslations, type Lang } from '@/i18n/ui';

export const getStaticPaths = (() =>
  perLocale(async (lang) =>
    (await getArtifacts(lang)).map((artifact) => ({
      params: { category: artifact.data.category, slug: slugOf(artifact) },
      props: { artifact },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  artifact: Artifact;
  lang: Lang;
}

const { artifact, lang } = Astro.props;
const t = useTranslations(lang);
const d = artifact.data;
const category = getArtifactCategory(d.category);
const { Content } = await render(artifact);

// Tools listed by the artifact, plus tools whose page points back to it.
const tools = [...new Set([...d.tools, ...(await toolsForArtifact(artifact, lang)).map((x) => slugOf(x))])];
const playbooks = await playbooksReferencing(artifact, lang);

const sections: (TocItem & { show: boolean })[] = [
  { id: 'what', label: t('sec.what'), show: true },
  { id: 'evidence', label: t('sec.evidence'), show: d.evidence.length > 0 },
  { id: 'location', label: t('sec.location'), show: d.locations.length > 0 },
  { id: 'questions', label: t('sec.questions'), show: d.questions.length > 0 },
  { id: 'tools', label: t('sec.tools'), show: tools.length > 0 },
  { id: 'look-for', label: t('sec.lookFor'), show: d.look_for.length > 0 },
  { id: 'limitations', label: t('sec.limitations'), show: d.limitations.length > 0 },
  { id: 'related', label: t('sec.related'), show: d.related_artifacts.length > 0 },
];
const toc = sections.filter((s) => s.show);
const n = (id: string) => toc.findIndex((s) => s.id === id) + 1;
const label = (id: string) => toc.find((s) => s.id === id)?.label ?? id;
---

<EntryLayout
  title={d.name}
  summary={d.summary}
  code={refCode('artifact', slugOf(artifact), d.category)}
  crumbs={[
    { label: t('nav.artifacts'), href: '/artifacts/' },
    { label: category.label[lang], href: `/artifacts/${category.id}/` },
    { label: d.name },
  ]}
  meta={[
    { label: t('meta.category'), value: category.label[lang] },
    { label: t('meta.also'), value: d.aliases },
    { label: t('meta.tags'), value: d.tags },
  ]}
  toc={toc}
  review={d.review}
  fallback={isFallback(artifact, lang)}
  updated={d.updated}
>
  <UsedInPlaybooks slot="header" playbooks={playbooks} />

  <Section id="what" title={label('what')} index={n('what')}>
    <div class="prose-k"><Content /></div>
  </Section>

  {
    d.evidence.length > 0 && (
      <Section id="evidence" title={label('evidence')} index={n('evidence')}>
        <BulletList items={d.evidence} />
      </Section>
    )
  }

  {
    d.locations.length > 0 && (
      <Section id="location" title={label('location')} index={n('location')}>
        <ul class="divide-y divide-ink-800 border border-ink-700 bg-ink-900">
          {d.locations.map((l) => (
            <li class="flex flex-col gap-1 px-3 py-2.5 sm:flex-row sm:items-baseline sm:gap-4">
              {l.label && <span class="label w-40 shrink-0 tracking-normal normal-case">{l.label}</span>}
              <code class="font-mono text-[0.8125rem] break-all text-paper">{l.path}</code>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    d.questions.length > 0 && (
      <Section id="questions" title={label('questions')} index={n('questions')}>
        <BulletList items={d.questions} />
      </Section>
    )
  }

  {
    tools.length > 0 && (
      <Section id="tools" title={label('tools')} index={n('tools')}>
        <RefList refs={tools} />
      </Section>
    )
  }

  {
    d.look_for.length > 0 && (
      <Section id="look-for" title={label('look-for')} index={n('look-for')}>
        <BulletList items={d.look_for} />
      </Section>
    )
  }

  {
    d.limitations.length > 0 && (
      <Section id="limitations" title={label('limitations')} index={n('limitations')}>
        <BulletList items={d.limitations} />
      </Section>
    )
  }

  {
    d.related_artifacts.length > 0 && (
      <Section id="related" title={label('related')} index={n('related')}>
        <div class="space-y-5">
          {d.related_artifacts.length > 0 && (
            <div>
              <p class="mb-2 text-sm text-mute">{t('related.artifacts')}</p>
              <RefList refs={d.related_artifacts} />
            </div>
          )}
        </div>
      </Section>
    )
  }
</EntryLayout>
