---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CategoryBlock from '@/components/CategoryBlock.astro';
import { getTools, refCode, slugOf, toolPath } from '@/lib/content';
import { TOOL_CATEGORIES, type Category } from '@/lib/taxonomy';
import { perLocale } from '@/i18n/routing';
import { useTranslations, type Lang } from '@/i18n/ui';

export const getStaticPaths = (() =>
  perLocale(() =>
    TOOL_CATEGORIES.map((category) => ({
      params: { category: category.id },
      props: { category: category as Category },
    })),
  )) satisfies GetStaticPaths;

const { category, lang } = Astro.props as { category: Category; lang: Lang };
const t = useTranslations(lang);
const tools = (await getTools(lang)).filter((x) => x.data.category === category.id);
const title = t('tools.catTitle', { label: category.label[lang] });
---

<BaseLayout title={title} description={category.description[lang]}>
  <PageHeader
    title={title}
    summary={category.description[lang]}
    crumbs={[{ label: t('tools.title'), href: '/tools/' }, { label: category.label[lang] }]}
  />
  <div class="mt-10">
    <CategoryBlock
      category={category}
      entries={tools.map((x) => ({
        href: toolPath(x),
        title: x.data.name,
        summary: x.data.summary,
        code: refCode('tool', slugOf(x), x.data.category),
        meta: x.data.type,
      }))}
    />
  </div>
</BaseLayout>
