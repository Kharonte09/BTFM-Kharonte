---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import EntryLayout from '@/layouts/EntryLayout.astro';
import Section from '@/components/Section.astro';
import BulletList from '@/components/BulletList.astro';
import CommandBlock from '@/components/CommandBlock.astro';
import StartHere from '@/components/StartHere.astro';
import MistakeList from '@/components/MistakeList.astro';
import WhatNext from '@/components/WhatNext.astro';
import type { TocItem } from '@/components/Toc.astro';
import { inline } from '@/lib/inline';
import {
  getDetections,
  isFallback,
  playbooksForDetection,
  refCode,
  slugOf,
  type Detection,
} from '@/lib/content';
import { perLocale } from '@/i18n/routing';
import { useTranslations, type Lang } from '@/i18n/ui';

export const getStaticPaths = (() =>
  perLocale(async (lang) =>
    (await getDetections(lang)).map((detection) => ({ params: { slug: slugOf(detection) }, props: { detection } })),
  )) satisfies GetStaticPaths;

interface Props {
  detection: Detection;
  lang: Lang;
}

const { detection, lang } = Astro.props;
const t = useTranslations(lang);
const d = detection.data;
const { Content } = await render(detection);
const hasBody = Boolean(detection.body?.trim());
const playbooks = await playbooksForDetection(detection, lang);
const hasNext = playbooks.length > 0 || d.related_artifacts.length > 0 || d.tools.length > 0;

const sections: (TocItem & { show: boolean })[] = [
  { id: 'start-here', label: t('sec.startHere'), show: d.start_here.length > 0 },
  { id: 'signs', label: t('sec.signs'), show: d.signs.length > 0 },
  { id: 'sources', label: t('sec.sources'), show: d.sources.length > 0 },
  { id: 'hunt', label: t('sec.hunt'), show: true },
  { id: 'confirm', label: t('sec.confirm'), show: d.confirm.length > 0 },
  { id: 'false-positives', label: t('sec.falsePositives'), show: d.false_positives.length > 0 },
  { id: 'reference', label: t('sec.reference'), show: hasBody },
  { id: 'extract', label: t('sec.extract'), show: d.extract.length > 0 },
  { id: 'mistakes', label: t('sec.mistakes'), show: d.mistakes.length > 0 },
  { id: 'next', label: t('sec.next'), show: hasNext },
];
const toc = sections.filter((s) => s.show);
const n = (id: string) => toc.findIndex((s) => s.id === id) + 1;
const label = (id: string) => toc.find((s) => s.id === id)?.label ?? id;
---

<EntryLayout
  title={d.name}
  summary={d.summary}
  code={refCode('detection', slugOf(detection))}
  crumbs={[{ label: t('nav.detections'), href: '/detections/' }, { label: d.name }]}
  meta={[
    { label: t('meta.runsOn'), value: d.platforms },
    { label: t('meta.mitre'), value: d.mitre },
    { label: t('meta.coverage'), value: t(`coverage.${d.coverage}`) },
    { label: t('meta.tags'), value: d.tags },
  ]}
  toc={toc}
  review={d.review}
  fallback={isFallback(detection, lang)}
  updated={d.updated}
>
  {d.start_here.length > 0 && <StartHere title={t('sec.startHere')} subtitle={t('sec.firstChecks')} steps={d.start_here} />}

  {
    d.signs.length > 0 && (
      <Section id="signs" title={label('signs')} index={n('signs')}>
        <BulletList items={d.signs} />
      </Section>
    )
  }

  {
    d.sources.length > 0 && (
      <Section id="sources" title={label('sources')} index={n('sources')}>
        <ul class="divide-y divide-ink-800 border border-ink-700 bg-ink-900">
          {d.sources.map((s) => (
            <li class="flex flex-col gap-1 px-3 py-2.5 sm:flex-row sm:items-baseline sm:gap-4">
              <span class="label w-40 shrink-0 tracking-normal normal-case">{s.source}</span>
              <span
                class="text-sm leading-relaxed text-paper-dim [&_code]:rounded-sm [&_code]:bg-ink-800 [&_code]:px-1 [&_code]:font-mono [&_code]:text-[0.85em] [&_code]:text-paper"
                set:html={inline(s.look)}
              />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section id="hunt" title={label('hunt')} index={n('hunt')}>
    <div class="space-y-8">
      {
        d.hunts.map((h) => (
          <div>
            <h3 class="flex items-center gap-2.5 font-semibold text-paper">
              <span aria-hidden="true" class="font-mono text-xs text-ember">▸</span>
              {h.source}
            </h3>
            {h.note && (
              <p
                class="mt-1.5 text-sm leading-relaxed text-mute [&_code]:rounded-sm [&_code]:bg-ink-800 [&_code]:px-1 [&_code]:font-mono [&_code]:text-[0.85em] [&_code]:text-paper-dim"
                set:html={inline(h.note)}
              />
            )}
            <div class="mt-3 space-y-3">
              {h.commands.map((c) => (
                <CommandBlock label={c.label} command={c.command} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  {
    d.confirm.length > 0 && (
      <Section id="confirm" title={label('confirm')} index={n('confirm')}>
        <BulletList items={d.confirm} />
      </Section>
    )
  }

  {
    d.false_positives.length > 0 && (
      <Section id="false-positives" title={label('false-positives')} index={n('false-positives')}>
        <BulletList items={d.false_positives} />
      </Section>
    )
  }

  {
    hasBody && (
      <Section id="reference" title={label('reference')} index={n('reference')}>
        <div class="prose-k">
          <Content />
        </div>
      </Section>
    )
  }

  {
    d.extract.length > 0 && (
      <Section id="extract" title={label('extract')} index={n('extract')}>
        <BulletList items={d.extract} />
      </Section>
    )
  }

  {
    d.mistakes.length > 0 && (
      <Section id="mistakes" title={label('mistakes')} index={n('mistakes')}>
        <MistakeList items={d.mistakes} />
      </Section>
    )
  }

  {
    hasNext && (
      <Section id="next" title={label('next')} index={n('next')}>
        <WhatNext playbooks={playbooks} artifacts={d.related_artifacts} tools={d.tools} />
      </Section>
    )
  }
</EntryLayout>
