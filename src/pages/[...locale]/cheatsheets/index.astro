---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import EntryCard from '@/components/EntryCard.astro';
import { cheatsheetPath, getCheatsheets, refCode, slugOf } from '@/lib/content';
import { localeStaticPaths } from '@/i18n/routing';
import { useTranslations, type Lang } from '@/i18n/ui';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const sheets = await getCheatsheets(lang);
---

<BaseLayout title={t('cheatsheets.title')} description={t('cheatsheets.summary')}>
  <PageHeader
    title={t('cheatsheets.title')}
    summary={t('cheatsheets.summary')}
    crumbs={[{ label: t('cheatsheets.title') }]}
  />
  <ul class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      sheets.map((s) => (
        <li>
          <EntryCard
            href={cheatsheetPath(s)}
            title={s.data.name}
            summary={s.data.summary}
            code={refCode('cheatsheet', slugOf(s))}
            meta={t('cheatsheets.rows', { n: s.data.sections.reduce((n, sec) => n + sec.rows.length, 0) })}
          />
        </li>
      ))
    }
  </ul>
</BaseLayout>
