---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import EntryLayout from '@/layouts/EntryLayout.astro';
import Section from '@/components/Section.astro';
import BulletList from '@/components/BulletList.astro';
import Flow from '@/components/Flow.astro';
import RefList from '@/components/RefList.astro';
import type { TocItem } from '@/components/Toc.astro';
import { inline } from '@/lib/inline';
import { getPlaybooks, isFallback, refCode, slugOf, type Playbook } from '@/lib/content';
import { perLocale } from '@/i18n/routing';
import { useTranslations, type Lang } from '@/i18n/ui';

export const getStaticPaths = (() =>
  perLocale(async (lang) =>
    (await getPlaybooks(lang)).map((playbook) => ({ params: { slug: slugOf(playbook) }, props: { playbook } })),
  )) satisfies GetStaticPaths;

interface Props {
  playbook: Playbook;
  lang: Lang;
}

const { playbook, lang } = Astro.props;
const t = useTranslations(lang);
const d = playbook.data;
const { Content } = await render(playbook);
const hasBody = Boolean(playbook.body?.trim());

const sections: (TocItem & { show: boolean })[] = [
  { id: 'start', label: t('sec.start'), show: true },
  { id: 'questions', label: t('sec.questions.pb'), show: d.questions.length > 0 },
  { id: 'steps', label: t('sec.steps'), show: true },
  { id: 'iocs', label: t('sec.iocs'), show: d.iocs.length > 0 },
  { id: 'escalate', label: t('sec.escalateWhen'), show: d.escalate_when.length > 0 },
  { id: 'notes', label: t('sec.pbNotes'), show: hasBody },
  { id: 'related', label: t('sec.relatedPlaybooks'), show: d.related_playbooks.length > 0 },
];
const toc = sections.filter((s) => s.show);
const n = (id: string) => toc.findIndex((s) => s.id === id) + 1;
const label = (id: string) => toc.find((s) => s.id === id)?.label ?? id;
---

<EntryLayout
  title={d.name}
  summary={d.summary}
  code={refCode('playbook', slugOf(playbook))}
  crumbs={[{ label: t('nav.playbooks'), href: '/playbooks/' }, { label: d.name }]}
  meta={[
    { label: t('meta.steps'), value: String(d.steps.length) },
    { label: t('meta.tags'), value: d.tags },
  ]}
  toc={toc}
  review={d.review}
  fallback={isFallback(playbook, lang)}
  updated={d.updated}
>
  <div slot="header" class="mt-6 space-y-5">
    <Flow steps={d.steps.map((s) => s.title)} compact links />
    <div
      data-pb-root={slugOf(playbook)}
      data-steps-tpl={t('progress.steps')}
      data-questions-tpl={t('progress.questions')}
      class="flex max-w-3xl flex-wrap items-center gap-x-4 gap-y-2"
    >
      <span class="label">{t('progress.label')}</span>
      <span class="relative h-1 min-w-32 flex-1 bg-ink-700" aria-hidden="true">
        <span data-pb-bar class="absolute inset-y-0 left-0 w-0 bg-ember transition-[width] duration-300"></span>
      </span>
      <span data-pb-count class="font-mono text-xs text-paper-dim" aria-live="polite"></span>
      <button
        type="button"
        data-pb-reset
        class="font-mono text-[0.6875rem] text-faint underline decoration-ink-500 underline-offset-4 hover:text-paper"
        title={t('progress.note')}
      >
        {t('progress.reset')}
      </button>
    </div>
  </div>

  <Section id="start" title={label('start')} index={n('start')}>
    <p
      class="leading-relaxed text-paper-dim [&_code]:font-mono [&_code]:text-paper [&_strong]:text-paper"
      set:html={inline(d.trigger)}
    />
  </Section>

  {
    d.questions.length > 0 && (
      <Section id="questions" title={label('questions')} index={n('questions')}>
        <ol class="space-y-2">
          {d.questions.map((q, i) => (
            <li>
              <label class="group flex cursor-pointer gap-3 leading-relaxed text-paper-dim has-checked:text-mute [&_code]:font-mono [&_code]:text-paper">
                <input
                  type="checkbox"
                  data-pb-q={i}
                  class="mt-1.5 size-3.5 shrink-0 cursor-pointer accent-ember"
                  aria-label={`${t('progress.questionDone')}: Q${i + 1}`}
                />
                <span class="mt-0.5 shrink-0 font-mono text-xs text-ember">Q{i + 1}</span>
                <span class="group-has-checked:line-through group-has-checked:decoration-ink-500" set:html={inline(q)} />
              </label>
            </li>
          ))}
        </ol>
      </Section>
    )
  }

  <Section id="steps" title={label('steps')} index={n('steps')}>
    <ol class="space-y-4">
      {
        d.steps.map((step, i) => (
          <li
            id={`step-${i + 1}`}
            data-pb-step-card
            class="scroll-mt-24 border border-ink-700 bg-ink-900 transition-colors has-[[data-pb-step]:checked]:border-ember/40"
          >
            <div class="flex items-center gap-3 border-b border-ink-700 px-4 py-3">
              <span class="font-mono text-xs text-ember">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="flex-1 font-semibold text-paper">{step.title}</h3>
              <label class="flex cursor-pointer items-center gap-2 font-mono text-[0.6875rem] text-faint hover:text-paper">
                <span class="hidden sm:inline">✓</span>
                <input
                  type="checkbox"
                  data-pb-step={i}
                  class="size-4 cursor-pointer accent-ember"
                  aria-label={`${t('progress.stepDone')}: ${step.title}`}
                />
              </label>
            </div>
            <div class="space-y-4 p-4">
              <p class="text-sm leading-relaxed text-paper" set:html={inline(step.goal)} />
              {step.actions.length > 0 && <BulletList items={step.actions} />}
              {(step.tools.length > 0 || step.artifacts.length > 0) && (
                <div class="grid gap-4 border-t border-ink-800 pt-4 sm:grid-cols-2">
                  {step.tools.length > 0 && (
                    <div>
                      <p class="label mb-2">{t('step.tools')}</p>
                      <RefList refs={step.tools} />
                    </div>
                  )}
                  {step.artifacts.length > 0 && (
                    <div>
                      <p class="label mb-2">{t('step.artifacts')}</p>
                      <RefList refs={step.artifacts} />
                    </div>
                  )}
                </div>
              )}
              {step.escalate && (
                <p class="border-l-2 border-ember pl-3 text-sm text-paper-dim [&_strong]:text-paper">
                  <span class="label mr-2 text-ember">{t('step.escalate')}</span>
                  <span set:html={inline(step.escalate)} />
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  {
    d.iocs.length > 0 && (
      <Section id="iocs" title={label('iocs')} index={n('iocs')}>
        <BulletList items={d.iocs} />
      </Section>
    )
  }

  {
    d.escalate_when.length > 0 && (
      <Section id="escalate" title={label('escalate')} index={n('escalate')}>
        <BulletList items={d.escalate_when} />
      </Section>
    )
  }

  {
    hasBody && (
      <Section id="notes" title={label('notes')} index={n('notes')}>
        <div class="prose-k">
          <Content />
        </div>
      </Section>
    )
  }

  {
    d.related_playbooks.length > 0 && (
      <Section id="related" title={label('related')} index={n('related')}>
        <RefList refs={d.related_playbooks} />
      </Section>
    )
  }
</EntryLayout>

<script>
  // Playbook progress (steps done, questions answered), stored per playbook in this browser.
  const root = document.querySelector<HTMLElement>('[data-pb-root]');
  if (root) {
    const key = `kh-pb:${root.dataset.pbRoot}`;
    const steps = [...document.querySelectorAll<HTMLInputElement>('[data-pb-step]')];
    const questions = [...document.querySelectorAll<HTMLInputElement>('[data-pb-q]')];
    const bar = root.querySelector<HTMLElement>('[data-pb-bar]');
    const count = root.querySelector<HTMLElement>('[data-pb-count]');

    const load = (): { s: number[]; q: number[] } => {
      try {
        const v = JSON.parse(localStorage.getItem(key) ?? '{}') as { s?: number[]; q?: number[] };
        return { s: v.s ?? [], q: v.q ?? [] };
      } catch {
        return { s: [], q: [] };
      }
    };
    const checked = (xs: HTMLInputElement[], attr: string) =>
      xs.filter((x) => x.checked).map((x) => Number(x.getAttribute(attr)));

    const render = () => {
      const s = checked(steps, 'data-pb-step');
      const q = checked(questions, 'data-pb-q');
      if (bar) bar.style.width = `${steps.length ? (s.length / steps.length) * 100 : 0}%`;
      const fill = (tpl: string | undefined, done: number, total: number) =>
        (tpl ?? '{done}/{total}').replace('{done}', String(done)).replace('{total}', String(total));
      if (count) {
        count.textContent = [
          fill(root.dataset.stepsTpl, s.length, steps.length),
          questions.length ? fill(root.dataset.questionsTpl, q.length, questions.length) : '',
        ]
          .filter(Boolean)
          .join(' · ');
      }
      // Mirror step state on the compact workflow strip.
      steps.forEach((x, i) => {
        document
          .querySelector(`a[href="#step-${i + 1}"]`)
          ?.classList.toggle('border-ember/60!', x.checked);
      });
      return { s, q };
    };

    const save = () => {
      const state = render();
      try {
        if (state.s.length || state.q.length) localStorage.setItem(key, JSON.stringify(state));
        else localStorage.removeItem(key);
      } catch {
        /* storage unavailable: progress lasts for this page only */
      }
    };

    const saved = load();
    steps.forEach((x) => (x.checked = saved.s.includes(Number(x.dataset.pbStep))));
    questions.forEach((x) => (x.checked = saved.q.includes(Number(x.dataset.pbQ))));
    render();

    [...steps, ...questions].forEach((x) => x.addEventListener('change', save));
    root.querySelector('[data-pb-reset]')?.addEventListener('click', () => {
      [...steps, ...questions].forEach((x) => (x.checked = false));
      save();
    });
  }
</script>
