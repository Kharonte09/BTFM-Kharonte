---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PlaybookCard from '@/components/PlaybookCard.astro';
import { getPlaybooks } from '@/lib/content';
import { localeStaticPaths } from '@/i18n/routing';
import { useTranslations, type Lang } from '@/i18n/ui';

export const getStaticPaths = (() => localeStaticPaths()) satisfies GetStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const playbooks = await getPlaybooks(lang);
---

<BaseLayout title={t('playbooks.title')} description={t('playbooks.summary')}>
  <PageHeader title={t('playbooks.title')} summary={t('playbooks.summary')} crumbs={[{ label: t('playbooks.title') }]} />

  <ul class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      playbooks.map((p, i) => (
        <li>
          <PlaybookCard playbook={p} index={i + 1} />
        </li>
      ))
    }
  </ul>
</BaseLayout>
