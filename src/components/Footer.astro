---
import Logo from './Logo.astro';
import { NAV } from '@/lib/site';
import { getLang, href } from '@/lib/url';
import { useTranslations } from '@/i18n/ui';

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const links = [...NAV, { key: 'nav.search', href: '/search/' }, { key: 'nav.about', href: '/about/' }] as const;
---

<footer class="mt-24 border-t border-ink-700">
  <div class="mx-auto grid max-w-page gap-8 px-4 py-10 sm:px-6 md:grid-cols-[1fr_auto]">
    <div class="max-w-md space-y-3">
      <p class="flex items-center gap-2.5 text-paper">
        <Logo size={18} />
        <span class="font-mono text-xs font-semibold tracking-[0.22em]">KHARONTE</span>
      </p>
      <p class="text-sm leading-relaxed text-mute">{t('footer.disclaimer')}</p>
      <p class="font-mono text-[0.6875rem] text-faint">{t('footer.meta')}</p>
    </div>
    <nav aria-label={t('nav.footer')}>
      <ul class="grid grid-cols-2 gap-x-10 gap-y-2 text-sm">
        {
          links.map((item) => (
            <li>
              <a href={href(lang, item.href)} class="text-mute transition-colors hover:text-paper">
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
