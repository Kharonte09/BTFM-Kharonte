---
import { Search } from '@lucide/astro';
import { getLang, href } from '@/lib/url';
import { useTranslations } from '@/i18n/ui';
import type { SearchStrings } from '@/lib/search-types';

interface Props {
  /** Unique id prefix (several panels can coexist on a page). */
  id: string;
  mode?: 'inline' | 'page' | 'dialog';
  size?: 'md' | 'lg';
  /** The page's main search: "/" and Ctrl+K focus it instead of opening the dialog. */
  primary?: boolean;
  examples?: string[];
}

const lang = getLang(Astro.url);
const DEFAULT_EXAMPLES = {
  en: ['prefetch', '4624', 'encodedcommand', 'macro', 'pcap', 'persistence', 'capa', 'base64'],
  es: ['prefetch', '4624', 'encodedcommand', 'macro', 'pcap', 'persistencia', 'capa', 'base64'],
};
const { id, mode = 'inline', size = 'md', primary = false, examples = DEFAULT_EXAMPLES[lang] } = Astro.props;
const t = useTranslations(lang);
const listId = `${id}-results`;

const strings: SearchStrings = {
  kinds: {
    artifact: t('kind.artifact'),
    tool: t('kind.tool'),
    playbook: t('kind.playbook'),
  },
  none: t('search.none'),
  related: t('search.related'),
  one: t('search.count.one'),
  many: t('search.count.many'),
  error: t('search.error'),
};
---

<div
  data-search-root
  data-search-primary={primary ? '' : undefined}
  data-index={href(lang, '/search-index.json')}
  data-strings={JSON.stringify(strings)}
  data-mode={mode}
  class="relative"
>
  <div
    class:list={[
      'flex items-center gap-3 border border-ink-600 bg-ink-900 transition-colors focus-within:border-ember/70',
      size === 'lg' ? 'px-4 py-3.5 sm:px-5 sm:py-4' : 'px-3 py-2.5',
    ]}
  >
    <Search size={size === 'lg' ? 20 : 17} stroke-width={1.5} class="shrink-0 text-mute" aria-hidden="true" />
    <label for={`${id}-input`} class="sr-only">{t('search.label')}</label>
    <input
      id={`${id}-input`}
      data-search-input
      type="search"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={listId}
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
      placeholder={t('search.placeholder')}
      class:list={[
        'w-full min-w-0 bg-transparent text-paper placeholder:text-faint focus:outline-none [&::-webkit-search-cancel-button]:hidden',
        size === 'lg' ? 'text-base sm:text-lg' : 'text-[0.95rem]',
      ]}
    />
    <span class="hidden shrink-0 items-center gap-1 sm:flex" aria-hidden="true">
      {mode === 'dialog' ? <span class="kbd">Esc</span> : <span class="kbd">/</span>}
    </span>
  </div>

  <p data-search-status class="sr-only" aria-live="polite"></p>

  <div
    id={listId}
    data-search-results
    role="listbox"
    aria-label={t('search.results')}
    hidden
    class:list={[
      'border border-t-0 border-ink-600 bg-ink-900',
      mode === 'dialog' && 'max-h-[min(60vh,32rem)] overflow-y-auto',
      mode === 'inline' &&
        'absolute inset-x-0 top-full z-30 max-h-[min(70vh,34rem)] overflow-y-auto shadow-2xl shadow-black/40',
    ]}
  >
  </div>

  {
    examples.length > 0 && (
      <div data-search-hint class="mt-3 flex flex-wrap items-center gap-2">
        <span class="label mr-1">{t('search.try')}</span>
        {examples.map((q) => (
          <button
            type="button"
            data-search-example={q}
            class="chip cursor-pointer hover:border-ember/60 hover:text-paper"
          >
            {q}
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  import '@/scripts/search';
</script>
