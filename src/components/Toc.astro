---
export interface TocItem {
  id: string;
  label: string;
}
interface Props {
  items: TocItem[];
}
const { items } = Astro.props;
---

<nav aria-label="On this page" class="hidden lg:block">
  <p class="label mb-3">On this page</p>
  <ol class="space-y-1 border-l border-ink-700 text-sm">
    {
      items.map((i, n) => (
        <li>
          <a
            href={`#${i.id}`}
            class="-ml-px flex gap-2 border-l border-transparent py-0.5 pl-3 text-mute transition-colors hover:border-ember hover:text-paper"
          >
            <span class="font-mono text-xs leading-5 text-faint">{String(n + 1).padStart(2, '0')}</span>
            {i.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>
