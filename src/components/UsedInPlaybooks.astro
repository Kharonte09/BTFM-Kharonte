---
import Icon from './Icon.astro';
import { playbookPath, type Playbook } from '@/lib/content';
import { getLang, href } from '@/lib/url';
import { useTranslations } from '@/i18n/ui';

/** Header strip on artifact/tool pages: the playbooks this entry belongs to. */
interface Props {
  playbooks: Playbook[];
}
const { playbooks } = Astro.props;
const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

{
  playbooks.length > 0 && (
    <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="label text-ember">{t('entry.usedIn')}</span>
      <ul class="flex flex-wrap gap-2">
        {playbooks.map((p) => (
          <li>
            <a
              href={href(lang, playbookPath(p))}
              class="flex items-center gap-2 border border-ink-600 bg-ink-900 px-2.5 py-1 text-sm text-paper-dim transition-colors hover:border-ember/60 hover:text-paper"
            >
              <Icon name={p.data.icon} size={14} class="text-ember" />
              {p.data.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
