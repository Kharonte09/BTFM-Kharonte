---
import { resolveRefs } from '@/lib/content';
import { getLang } from '@/lib/url';
import { useTranslations } from '@/i18n/ui';

/** Renders cross references as chips; known entries become links. */
interface Props {
  refs: string[];
}
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const resolved = await resolveRefs(Astro.props.refs, lang);
---

{
  resolved.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {resolved.map((r) => (
        <li>
          {r.href ? (
            <a href={r.href} class="chip">
              <span aria-hidden="true" class="text-ember">
                →
              </span>
              {r.label}
            </a>
          ) : (
            <span class="chip border-dashed text-mute" title={t('ref.missing')}>
              {r.label}
            </span>
          )}
        </li>
      ))}
    </ul>
  )
}
