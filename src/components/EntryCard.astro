---
import { url } from '@/lib/url';

interface Props {
  href: string;
  title: string;
  summary: string;
  code?: string;
  meta?: string;
}
const { href, title, summary, code, meta } = Astro.props;
---

<a
  href={url(href)}
  class="group flex h-full flex-col gap-2 border border-ink-700 bg-ink-900 p-4 transition-colors hover:border-ink-500 hover:bg-ink-850"
>
  {code && <span class="label truncate text-faint">{code}</span>}
  <h3 class="flex items-center gap-2 font-semibold text-paper">
    {title}
    <span
      aria-hidden="true"
      class="text-ember opacity-0 transition-all group-hover:translate-x-0.5 group-hover:opacity-100"
    >
      →
    </span>
  </h3>
  {meta && <span class="-mt-1 font-mono text-xs text-mute">{meta}</span>}
  <p class="text-sm leading-relaxed text-mute">{summary}</p>
</a>
